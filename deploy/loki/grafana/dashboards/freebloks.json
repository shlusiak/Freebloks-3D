{
 "uid": "freebloks",
 "title": "Freebloks",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "game_id",
    "type": "textbox",
    "label": "game_id",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Games started",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     },
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({container=\"freebloks\"} | logfmt | event=\"game_started\" [$__interval]))",
     "legendFormat": "started",
     "queryType": "range"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Players in started games",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     },
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(sum_over_time({container=\"freebloks\"} | logfmt | event=\"game_started\" | unwrap players [$__interval]))",
     "legendFormat": "players",
     "queryType": "range"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Games finished",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     },
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({container=\"freebloks\"} | logfmt | event=\"game_finished\" [$__interval]))",
     "legendFormat": "finished",
     "queryType": "range"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Events by level (warn, error)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     },
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (event) (count_over_time({container=\"freebloks\"} | logfmt | level=~\"warn|error\" [$__interval]))",
     "legendFormat": "{{event}}",
     "queryType": "range"
    }
   ]
  },
  {
   "id": 5,
   "type": "logs",
   "title": "Chat of game $game_id",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 10
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Ascending"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{container=\"freebloks\"} | logfmt | event=\"chat\" | game_id=\"$game_id\" | line_format \"#{{.client}}: {{.msg}}\"",
     "queryType": "range"
    }
   ]
  },
  {
   "id": 6,
   "type": "logs",
   "title": "Recent games (game_started)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 24,
    "h": 8
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": false,
    "sortOrder": "Descending"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{container=\"freebloks\"} | logfmt | event=\"game_started\" | line_format \"game_id={{.game_id}} players={{.players}} clients={{.clients}} mode={{.mode}}\"",
     "queryType": "range"
    }
   ]
  }
 ]
}